[Unit]
Description=Subscription usage dashboard
After=network-online.target subs.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/usage
Environment=NODE_ENV=production
Environment=PORT=8320
Environment=CPA_BASE_URL=http://127.0.0.1:8317
Environment=CPA_MANAGEMENT_KEY_FILE=%h/subs/management.key
Environment=CPA_AUTH_DIR=%h/subs/auth
Environment=OPENCODE_GO_ENV_FILE=%h/.config/subs/opencode-go.env
Environment=USAGE_CACHE_TTL_MS=300000
# Persisted account samples: ~/.local/state/usage/state.json (exported as $STATE_DIRECTORY).
# StateDirectory= bind-mounts it writable, so ProtectHome=read-only needs no ReadWritePaths=.
StateDirectory=usage
StateDirectoryMode=0700
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
